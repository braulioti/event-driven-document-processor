# API
APP_NAME=Event-Driven Document Processor
APP_VERSION=0.1.0
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCUMENT_TOPIC=document.events
KAFKA_CONSUMER_GROUP=document-processor

# AWS (LocalStack-ready)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=document-processor
SQS_QUEUE_NAME=document-retry-queue

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s
LOG_JSON=true
